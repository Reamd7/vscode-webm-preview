{
  "name": "webm-extension-demo",
  "version": "0.0.0",
  "publisher": "your-publisher-name",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "test:e2e": "node scripts/run-e2e.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@rslib/core": "^0.20.0",
    "@rstest/adapter-rslib": "^0.2.1",
    "@rstest/core": "^0.9.0",
    "@types/node": "^24.12.0",
    "@types/vscode": "^1.110.0",
    "@typescript/native-preview": "7.0.0-dev.20260324.1",
    "@vscode/test-electron": "^2.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,astro}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.33.0",
    "vscode": "^1.85.0"
  },
  "packageManager": "pnpm@10.33.0"
}
